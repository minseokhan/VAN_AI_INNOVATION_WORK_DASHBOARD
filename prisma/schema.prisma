generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum AdminType {
  PLANNING
  DEV
}

enum ProjectStatus {
  UNASSIGNED
  IN_PROGRESS
  DONE
}

enum Position {
  FE
  BE
  AI
  PM
  ETC
}

enum InquiryKind {
  QUESTION
  SUGGESTION
  BUG
}

enum PlanDocKind {
  FILE
  LINK
}

enum SkillLevel {
  BEGINNER
  NOVICE
  INTERMEDIATE
  ADVANCED
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique
  passwordHash String
  name         String
  role         Role       @default(MEMBER)
  adminType    AdminType?
  approved     Boolean    @default(false)
  createdAt    DateTime   @default(now())

  // 역량 프로필 (본인이 /settings에서 작성, 운영진이 열람)
  level     SkillLevel?
  tools     String?
  skills    String?
  interests String?
  bio       String?

  /// 운영진이 판단해 지정하는 수준. 본인이 쓰는 level 과 별도로 둬서 서로 덮지 않는다
  adminLevel SkillLevel?

  /// 본인이 고른 선호 포지션. 실제 배치 포지션(ProjectMember.position)과는 별개
  preferredPosition Position?

  memberships      ProjectMember[]
  createdFeatures  Feature[]       @relation("FeatureCreatedBy")
  weeklyUpdates    WeeklyUpdate[]
  uploadedPlanDocs PlanDoc[]
  questions        Question[]      @relation("QuestionAuthor")
  answers          Question[]      @relation("QuestionAnsweredBy")
  profileLinks     ProfileLink[]
  reportNotes      ReportNote[]
  inquiries        Inquiry[]       @relation("InquiryAuthor")
  inquiryAnswers   Inquiry[]       @relation("InquiryAnsweredBy")
}

model Project {
  id           String        @id @default(cuid())
  code         String        @unique
  category     String
  priority     String
  dueDate      DateTime?
  title        String
  summary      String
  description  String
  status       ProjectStatus @default(UNASSIGNED)
  githubUrl    String?
  deployUrl    String?
  mainLanguage String?
  infraNote    String?
  startedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  members       ProjectMember[]
  features      Feature[]
  weeklyUpdates WeeklyUpdate[]
  planDocs      PlanDoc[]
  questions     Question[]
}

model ProjectMember {
  projectId  String
  userId     String
  position   Position @default(ETC)
  isLead     Boolean  @default(false)
  assignedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

model Feature {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  done        Boolean  @default(false)
  order       Int
  createdById String?
  createdAt   DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("FeatureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model WeeklyUpdate {
  id           String   @id @default(cuid())
  projectId    String
  authorId     String
  weekStart    DateTime @db.Date
  didThisWeek  String
  planNextWeek String
  issues       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([projectId, weekStart])
}

/**
 * 개인 포트폴리오·이력서 링크 또는 업로드 파일
 */
model ProfileLink {
  id        String      @id @default(cuid())
  userId    String
  title     String
  kind      PlanDocKind
  url       String
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/** 주차별 운영진 총평·특이사항. 한 주에 하나 */
model ReportNote {
  weekStart DateTime @id @db.Date
  authorId  String
  content   String
  updatedAt DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model PlanDoc {
  id           String      @id @default(cuid())
  projectId    String
  title        String
  kind         PlanDocKind
  url          String
  uploadedById String
  createdAt    DateTime    @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/** 사이트 자체에 대한 문의·건의. 프로젝트와 무관하며 운영진·부원 모두 남길 수 있다 */
model Inquiry {
  id           String      @id @default(cuid())
  authorId     String
  kind         InquiryKind @default(QUESTION)
  content      String
  answer       String?
  answeredById String?
  answeredAt   DateTime?
  createdAt    DateTime    @default(now())

  author     User  @relation("InquiryAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  answeredBy User? @relation("InquiryAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Question {
  id              String    @id @default(cuid())
  projectId       String
  authorId        String
  content         String
  answer          String?
  answeredById    String?
  answeredAt      DateTime?
  sentToDiscordAt DateTime?
  createdAt       DateTime  @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author     User    @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  answeredBy User?   @relation("QuestionAnsweredBy", fields: [answeredById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([sentToDiscordAt])
}
